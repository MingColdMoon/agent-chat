# Optional server-side model defaults. Users can also enter keys in the UI.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com

# Development-only database credentials used by docker-compose.yml.
POSTGRES_PASSWORD=agent

# Use a long random value outside local development.
JWT_SECRET=local-dev-jwt-secret-change-before-production

