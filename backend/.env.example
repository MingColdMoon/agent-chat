# Leave the key empty to run the built-in demo agent.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional server-side DeepSeek fallback. The UI value takes priority.
DEEPSEEK_API_KEY=

# Optional server-side Tavily fallback. The UI value takes priority.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com

# Optional MediaCrawler WebUI API service.
# Leave empty to show an executable task preview without running a crawler.
MEDIACRAWLER_API_URL=
MEDIACRAWLER_API_TOKEN=

AGENT_MAX_STEPS=6
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:18080,http://127.0.0.1:18080

DATABASE_URL=postgresql+asyncpg://agent:agent@127.0.0.1:5433/agent_chat
REDIS_URL=redis://127.0.0.1:6380/0
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=agent-chat
JWT_EXPIRATION_MINUTES=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=600

